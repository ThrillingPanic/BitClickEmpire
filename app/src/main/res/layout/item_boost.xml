<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FF16213E"
    android:padding="12dp"
    android:layout_marginBottom="2dp">

    <!-- Left: Boost details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_boost_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Boost Name"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tv_boost_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lv.0/10"
                android:textSize="12sp"
                android:textColor="#FFF7931A"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_boost_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="12sp"
            android:textColor="#88FFFFFF"
            android:fontFamily="monospace"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/tv_boost_effect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current effect"
            android:textSize="12sp"
            android:textColor="#FF4EC9B0"
            android:fontFamily="monospace"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/tv_boost_cost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cost: 100 BTC"
            android:textSize="12sp"
            android:textColor="#FFF7931A"
            android:fontFamily="monospace"
            android:paddingTop="2dp" />
    </LinearLayout>

    <!-- Right: Buy button -->
    <Button
        android:id="@+id/btn_buy_boost"
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:text="BUY"
        android:textSize="13sp"
        android:textColor="#FF1A1A2E"
        android:textStyle="bold"
        android:backgroundTint="#FFF7931A"
        android:fontFamily="monospace" />

</LinearLayout>
