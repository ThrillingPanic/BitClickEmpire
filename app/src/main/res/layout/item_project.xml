<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="#FF16213E">

    <!-- Project header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_project_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_project_difficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#FFF7931A"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_project_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#88FFFFFF"
        android:fontFamily="monospace"
        android:paddingTop="2dp" />

    <!-- Info row: time + reward -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/tv_project_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#AAFFFFFF"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_project_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FF4EC9B0"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Required roles -->
    <TextView
        android:id="@+id/tv_project_roles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#CCFFFFFF"
        android:fontFamily="monospace"
        android:paddingTop="4dp" />

    <!-- Start button -->
    <Button
        android:id="@+id/btn_start_project"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:text="START PROJECT"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF0F3460"
        android:fontFamily="monospace" />

</LinearLayout>
