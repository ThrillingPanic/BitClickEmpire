<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF1A1A2E">

    <!-- Header: coin display -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FF16213E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_coins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 BTC"
                android:textSize="32sp"
                android:textColor="#FFF7931A"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tv_per_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 BTC/sec"
                android:textSize="16sp"
                android:textColor="#AAFFFFFF"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tv_click_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+1.0 per click"
                android:textSize="14sp"
                android:textColor="#88FFFFFF"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_dev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:text="🛠"
            android:textSize="16sp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />
    </RelativeLayout>

    <!-- Tab content area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Click tab -->
        <FrameLayout
            android:id="@+id/tab_click"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <TextView
                android:id="@+id/btn_bitcoin"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="₿"
                android:textSize="100sp"
                android:textColor="#FFF7931A"
                android:background="@drawable/bitcoin_bg"
                android:clickable="true"
                android:focusable="true"
                android:elevation="8dp" />

            <com.bitclickempire.game.BitcoinParticleView
                android:id="@+id/particle_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="12dp" />

            <com.bitclickempire.game.ByteFloaterView
                android:id="@+id/byte_floater"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="14dp" />

            <!-- Byte bonus active indicator -->
            <TextView
                android:id="@+id/tv_byte_bonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:text="🔴 BYTE BONUS 5x INCOME! 🔴"
                android:textSize="14sp"
                android:textColor="#FFE63946"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:background="#CC1A1A2E"
                android:elevation="16dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Upgrades tab -->
        <LinearLayout
            android:id="@+id/tab_upgrades"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  SOFTWARE EMPIRE"
                android:textSize="14sp"
                android:textColor="#FFF7931A"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:background="#FF0F3460"
                android:fontFamily="monospace" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_upgrades"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF1A1A2E" />
        </LinearLayout>

        <!-- Projects tab -->
        <LinearLayout
            android:id="@+id/tab_projects"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Worker pool summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="#FF0F3460">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="  TEAM"
                    android:textSize="14sp"
                    android:textColor="#FFF7931A"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tv_workers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#CCFFFFFF"
                    android:fontFamily="monospace"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp" />

                <Button
                    android:id="@+id/btn_hire"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="4dp"
                    android:text="HIRE STAFF"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF0F3460"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Active projects section -->
            <TextView
                android:id="@+id/tv_active_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  ACTIVE PROJECTS"
                android:textSize="13sp"
                android:textColor="#FF4EC9B0"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:fontFamily="monospace"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_active_projects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FF1A1A2E"
                android:nestedScrollingEnabled="false" />

            <!-- Available projects section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  AVAILABLE PROJECTS"
                android:textSize="13sp"
                android:textColor="#FFF7931A"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:fontFamily="monospace" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_projects"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF1A1A2E" />
        </LinearLayout>

        <!-- Boosts tab -->
        <LinearLayout
            android:id="@+id/tab_boosts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  BOOSTS &amp; PERKS"
                android:textSize="14sp"
                android:textColor="#FFF7931A"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:background="#FF0F3460"
                android:fontFamily="monospace" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_boosts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF1A1A2E" />
        </LinearLayout>

        <!-- Casino tab -->
        <ScrollView
            android:id="@+id/tab_casino"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#FF1A1A2E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Game selector header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FF0F3460"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="💣 MINES"
                        android:textSize="13sp"
                        android:textColor="#FFF7931A"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🃏 SOON"
                        android:textSize="13sp"
                        android:textColor="#44FFFFFF"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="🎡 SOON"
                        android:textSize="13sp"
                        android:textColor="#44FFFFFF"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Max bet display -->
                <TextView
                    android:id="@+id/tv_casino_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Max Bet: 0.0 BTC"
                    android:textSize="13sp"
                    android:textColor="#AAFFFFFF"
                    android:gravity="center"
                    android:padding="6dp"
                    android:fontFamily="monospace" />

                <!-- ===== Mines Setup Section ===== -->
                <LinearLayout
                    android:id="@+id/mines_setup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Mine count selector -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Number of Mines"
                        android:textSize="13sp"
                        android:textColor="#CCFFFFFF"
                        android:fontFamily="monospace"
                        android:paddingBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btn_mine_minus"
                            android:layout_width="48dp"
                            android:layout_height="40dp"
                            android:text="−"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#FF0F3460" />

                        <TextView
                            android:id="@+id/tv_mine_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="3"
                            android:textSize="24sp"
                            android:textColor="#FFF7931A"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <Button
                            android:id="@+id/btn_mine_plus"
                            android:layout_width="48dp"
                            android:layout_height="40dp"
                            android:text="+"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#FF0F3460" />
                    </LinearLayout>

                    <!-- Bet input -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bet Amount (BTC)"
                        android:textSize="13sp"
                        android:textColor="#CCFFFFFF"
                        android:fontFamily="monospace"
                        android:paddingTop="12dp"
                        android:paddingBottom="4dp" />

                    <EditText
                        android:id="@+id/et_mines_bet"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:inputType="numberDecimal"
                        android:hint="Enter bet..."
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#44FFFFFF"
                        android:background="#FF0F3460"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:fontFamily="monospace" />

                    <!-- Quick bet buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <Button
                            android:id="@+id/btn_bet_25"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="25%"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#FF0F3460"
                            android:fontFamily="monospace" />

                        <Button
                            android:id="@+id/btn_bet_50"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:text="50%"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#FF0F3460"
                            android:fontFamily="monospace" />

                        <Button
                            android:id="@+id/btn_bet_max"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="MAX"
                            android:textSize="12sp"
                            android:textColor="#FF1A1A2E"
                            android:textStyle="bold"
                            android:backgroundTint="#FFF7931A"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Start button -->
                    <Button
                        android:id="@+id/btn_start_mines"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:text="⛏ START GAME"
                        android:textSize="16sp"
                        android:textColor="#FF1A1A2E"
                        android:textStyle="bold"
                        android:backgroundTint="#FFF7931A"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- ===== Mines Game Section ===== -->
                <LinearLayout
                    android:id="@+id/mines_game_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <!-- Multiplier display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/tv_mines_multiplier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.00x"
                            android:textSize="28sp"
                            android:textColor="#FF4EC9B0"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tv_mines_next"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  → 1.10x"
                            android:textSize="16sp"
                            android:textColor="#88FFFFFF"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_mines_potential"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Potential: 0 BTC"
                        android:textSize="14sp"
                        android:textColor="#FFF7931A"
                        android:fontFamily="monospace"
                        android:paddingBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_mines_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#88FFFFFF"
                        android:fontFamily="monospace"
                        android:paddingBottom="8dp" />

                    <!-- Grid container (populated programmatically) -->
                    <LinearLayout
                        android:id="@+id/mines_grid_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center" />

                    <!-- Action button -->
                    <Button
                        android:id="@+id/btn_mines_action"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="💰 CASH OUT"
                        android:textSize="16sp"
                        android:textColor="#FF1A1A2E"
                        android:textStyle="bold"
                        android:backgroundTint="#FF4EC9B0"
                        android:fontFamily="monospace" />

                    <!-- Result text -->
                    <TextView
                        android:id="@+id/tv_mines_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:paddingTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom navigation tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FF16213E"
        android:elevation="8dp">

        <TextView
            android:id="@+id/nav_click"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⛏ Click"
            android:textSize="11sp"
            android:textColor="#FFF7931A"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#FF0F3460" />

        <TextView
            android:id="@+id/nav_upgrades"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏢 Biz"
            android:textSize="11sp"
            android:textColor="#88FFFFFF"
            android:fontFamily="monospace"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#FF0F3460" />

        <TextView
            android:id="@+id/nav_projects"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📋 Jobs"
            android:textSize="11sp"
            android:textColor="#88FFFFFF"
            android:fontFamily="monospace"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#FF0F3460" />

        <TextView
            android:id="@+id/nav_boosts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚡ Boost"
            android:textSize="11sp"
            android:textColor="#88FFFFFF"
            android:fontFamily="monospace"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#FF0F3460" />

        <TextView
            android:id="@+id/nav_casino"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎰 Casino"
            android:textSize="11sp"
            android:textColor="#88FFFFFF"
            android:fontFamily="monospace"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
